{
  "name": "qaid-alhushud",
  "version": "0.1.0",
  "description": "Warlord: Crowd Commander - vertical slice (client/server/shared)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:client": "esbuild client/src/main.ts --bundle --format=iife --define:process.env.BASE_SPEED='\"1\"' --outfile=client/dist/bundle.js --log-level=warning && cp client/static/index.html client/static/styles.css client/dist/",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --external:ws --outfile=server/dist/index.js --log-level=warning",
    "build": "npm run build:client && npm run build:server",
    "start": "node server/dist/index.js",
    "test:sim": "esbuild shared/simulation/test/sim.test.ts --bundle --platform=node --outfile=.build/sim.test.js --log-level=warning && node .build/sim.test.js",
    "sim": "esbuild tools/sim-runner/run.ts --bundle --platform=node --outfile=.build/sim-runner.js --log-level=warning && node .build/sim-runner.js",
    "build:artifact": "esbuild client/src/main.ts --bundle --minify --format=iife --define:process.env.BASE_SPEED='\"1\"' --outfile=client/dist/bundle.solo.js --log-level=warning",
    "build:tahaddi": "esbuild server/src/tahaddi/index.ts --bundle --platform=node --format=esm --external:ws --outfile=server/dist/tahaddi.js --log-level=warning",
    "start:tahaddi": "node server/dist/tahaddi.js",
    "test:tahaddi": "node tools/check-emoji.cjs && node tools/test-rank-core.cjs && node tools/test-router.cjs && node tools/test-carrom-physics.cjs && npm run build:tahaddi && node tools/test-tahaddi-server.cjs",
    "game:build": "node tools/build.mjs",
    "game:check": "node tools/build.mjs --check",
    "web:build": "node tools/build-www.cjs",
    "web:serve": "npm run build:tahaddi && npm run start:tahaddi",
    "docker:build": "docker build -f server/Dockerfile -t tahaddi .",
    "docker:run": "docker run --rm -p 8090:8090 -v tahaddi_data:/data tahaddi",
    "cap:setup": "npm i -D @capacitor/core @capacitor/cli @capacitor/android @capacitor/ios && npx cap add android && npx cap add ios",
    "cap:sync": "npm run web:build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "qa:crawl": "node tools/qa-crawl.cjs",
    "qa:content": "node tools/qa-content.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABDULRAHMAN-SAID/almshani.git"
  },
  "bugs": {
    "url": "https://github.com/ABDULRAHMAN-SAID/almshani/issues"
  },
  "homepage": "https://github.com/ABDULRAHMAN-SAID/almshani#readme",
  "dependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/three": "^0.185.4",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.4"
  }
}
